[Unit]
Description=SUBAY gunicorn (localhost-only research database)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=subay
Group=subay
RuntimeDirectory=subay
WorkingDirectory=/opt/subay
# Secrets live ONLY here: a root-owned, chmod 0600 file. Never in the repo or settings.
EnvironmentFile=/etc/subay/subay.env
# Absolute path into the conda env (NOT `conda run` — systemd needs the real
# main PID for signal forwarding/restart). Env lives at /opt/conda/envs/subay_env.
ExecStart=/opt/conda/envs/subay_env/bin/gunicorn --config /opt/subay/deploy/gunicorn.conf.py subay.wsgi:application
Restart=on-failure

# Hardening — least privilege for a single-operator box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/subay/analysis_sets /run/subay

[Install]
WantedBy=multi-user.target
