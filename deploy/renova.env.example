# Production secrets template for systemd's EnvironmentFile.
# Install at /etc/renova/renova.env, owned root:root, chmod 0600.
# systemd loads this into the gunicorn process. It is NEVER committed and Django
# NEVER reads secrets from the repo or settings.py.

DJANGO_SECRET_KEY=replace-with-64-random-bytes
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://renova:STRONGPASSWORD@127.0.0.1:5432/renova

# --- Slice 15 (production hardening) additions. Placeholders only. ---
# pgcrypto symmetric key for sensitive columns (AC1). Escrow on a SEPARATE custody
# path; losing it makes encrypted backups unreadable.
RENOVA_PGCRYPTO_KEY=replace-with-strong-passphrase
# GPG recipient that encrypts the media + secrets backup archives (AC5).
BACKUP_GPG_RECIPIENT=backup-key@example.org
# Where the secrets/key archive goes — DIFFERENT mount from the data backups (AC5).
KEY_DEST=/mnt/keycustody/renova
# Push channel for operator alerts; quiet when healthy (AC6). No PHI ever sent.
RENOVA_ALERT_WEBHOOK=https://hooks.example.org/replace-me
# Dead-man's-switch heartbeat endpoint, pinged only on a HEALTHY run (AC6).
RENOVA_DEADMAN_URL=https://deadman.example.org/ping/replace-me
