// deploy/apt/20auto-upgrades — Slice 15 §4: enable the periodic unattended run.
// Install as /etc/apt/apt.conf.d/20auto-upgrades (pairs with 50unattended-upgrades-subay).

APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
