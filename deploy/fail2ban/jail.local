# SUBAY — fail2ban (Slice 15, AC2).
# Install at /etc/fail2ban/jail.local, then: sudo systemctl enable --now fail2ban
#
# WHY: even with key-only SSH, a flood of failed attempts is noise and an attack
# signal. Ban repeat offenders; the SSH-anomaly count feeds monitoring (AC6).

[DEFAULT]
# Ban for 1h after 4 failures inside 10 min. ignoreip keeps the admin subnet safe
# from self-lockout.
bantime  = 1h
findtime = 10m
maxretry = 4
ignoreip = 127.0.0.1/8 ::1 192.0.2.0/24

[sshd]
enabled  = true
backend  = systemd
port     = 22
