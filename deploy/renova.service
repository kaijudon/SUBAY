[Unit]
Description=RENOVA gunicorn (localhost-only research database)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=renova
Group=renova
RuntimeDirectory=renova
WorkingDirectory=/opt/renova
# Secrets live ONLY here: a root-owned, chmod 0600 file. Never in the repo or settings.
EnvironmentFile=/etc/renova/renova.env
ExecStart=/opt/renova/.venv/bin/gunicorn --config /opt/renova/deploy/gunicorn.conf.py renova.wsgi:application
Restart=on-failure

# Hardening — least privilege for a single-operator box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/renova/analysis_sets /run/renova

[Install]
WantedBy=multi-user.target
