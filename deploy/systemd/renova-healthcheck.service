# deploy/systemd/renova-healthcheck.service — Slice 15 §6: monitoring unit
# Install: sudo cp deploy/systemd/renova-healthcheck.{service,timer} /etc/systemd/system/
#          sudo systemctl enable --now renova-healthcheck.timer
[Unit]
Description=RENOVA push-on-failure healthcheck

[Service]
Type=oneshot
User=root
# Edit these to your real alert channel + dead-man's-switch endpoint. No PHI is
# ever sent; the script emits only metric names, counts, and the host name.
Environment=RENOVA_APP_URL=https://127.0.0.1/
Environment=RENOVA_ALERT_CMD=
Environment=RENOVA_HEARTBEAT_URL=
ExecStart=/opt/renova/deploy/bin/healthcheck.sh
