# deploy/systemd/renova-backup.service — Slice 15 §5: nightly backup unit
# Install: sudo cp deploy/systemd/renova-backup.{service,timer} /etc/systemd/system/
#          sudo systemctl enable --now renova-backup.timer
[Unit]
Description=RENOVA three-part encrypted backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
# Secrets (DATABASE_URL etc.) come from the same root-owned 0600 env file as the app.
EnvironmentFile=/etc/renova/renova.env
# Off-machine target and the SEPARATE-custody key path (edit to your mounts).
Environment=RENOVA_BACKUP_DEST=/mnt/backup/renova
Environment=RENOVA_BACKUP_KEYFILE=/mnt/keys/renova-backup.key
Environment=MEDIA_ROOT=/opt/renova/media
ExecStart=/opt/renova/deploy/bin/backup.sh
# Hardening: the backup needs to read the DB and MEDIA_ROOT and write the targets.
ProtectSystem=strict
ReadWritePaths=/mnt/backup/renova /var/lib/renova /var/backups/renova
PrivateTmp=true
