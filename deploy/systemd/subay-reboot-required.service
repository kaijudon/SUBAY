# SUBAY — operator reboot gate (Slice 15, AC4).
# Install at /etc/systemd/system/subay-reboot-required.{service,timer}.
# Pair with the .timer below (same basename). enable --now the TIMER, not the service.
#
# WHY: unattended-upgrades NEVER auto-reboots this LUKS box (50unattended-upgrades-subay).
# Instead this checks for the kernel's /run/reboot-required flag daily and PUSHES a
# notice to the operator, who reboots manually and unlocks LUKS at the console. The
# machine never reboots itself into a hung passphrase prompt.

[Unit]
Description=SUBAY: notify operator when a reboot is pending (never auto-reboot)

[Service]
Type=oneshot
# Reuse the monitoring push channel (AC6) so all operator alerts arrive the same way.
ExecStart=/opt/subay/deploy/bin/notify-operator.sh "reboot-required" \
    "Security updates installed; a manual console reboot + LUKS unlock is pending."
ExecCondition=/usr/bin/test -f /run/reboot-required
