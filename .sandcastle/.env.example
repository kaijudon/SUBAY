# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
# GitHub token for the AFK Tester/Reviewer to file and close issues on kaijudon/SUBAY.
# Needs `repo` scope. Create one with: gh auth token   (or a fine-grained PAT with
# Issues: read/write). Set it in .sandcastle/.env (not committed).
GH_TOKEN=
