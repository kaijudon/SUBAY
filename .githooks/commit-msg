#!/usr/bin/env bash
# Strip agent-attribution trailers from every commit message (CLAUDE.md "Commits/PRs").
#
# This lives in .githooks/ rather than .git/hooks/ so it is versioned and travels
# with a clone. The old copy sat in .git/hooks/, which protects exactly one
# working copy: commits made on the deploy box carried the trailer straight past
# it. Activate with `git config core.hooksPath .githooks`, which .githooks/setup.sh does.
#
# A hook can only ever be advisory - `--no-verify` skips it and a fresh clone
# will not have core.hooksPath set until someone runs the setup script. The CI
# job in .github/workflows/no-agent-attribution.yml is the layer that cannot be
# bypassed; this one just means you rarely reach it.
set -euo pipefail

msg_file="$1"
before=$(cat "$msg_file")

# Both known shapes: the git trailer, and the markdown footer the Claude Code
# harness appends to PR bodies (which sometimes reaches commit messages too).
#
# The footer rule deletes the WHOLE LINE rather than the phrase. The footer is
# usually prefixed with a robot emoji, and perl reads this file as bytes, so a
# \x{1F916} codepoint match silently leaves the four raw bytes behind - a
# stripped-looking message with a stray emoji on its own line. Matching the
# prefix as raw bytes sidesteps the encoding question entirely.
#
# That prefix is \W* and NOT .*, which is the whole difference between "eat the
# emoji" and "eat any line that mentions the footer". The earlier .* silently
# deleted documentation: a commit message explaining this rule lost the line
# that explained it, with only the advisory notice on stderr to say so.
#
# The trailer rule names no model. "Claude Opus 4.8" was yesterday's, "Claude
# Opus 5" is today's, and pinning either would mean editing this file every time
# the model changes - a guard that silently lapses. Matching the anthropic.com
# address or the Claude name covers all of them, current and future.
#
# Both rules anchor to the start of a line, because a real trailer always sits at
# one. Prose ABOUT the rule does not: `.sandcastle/*.md` and this repo's own docs
# say things like "do NOT add a `Co-Authored-By:` trailer", and a guard that
# fires on its own documentation is a guard people learn to bypass.
#
# The \n is optional in both rules. A trailer on the LAST line of a message with
# no final newline would otherwise slip through untouched, and that is exactly
# the shape a trailer takes: appended at the very end.
perl -0pi -e '
  s/^Co-Authored-By:.*(?:Claude|anthropic\.com).*\n?//gim;
  s/^\W*Generated with \[Claude Code\]\(.*\n?//gim;
' "$msg_file"

# Collapse the blank lines the removal leaves behind, then trim trailing space.
perl -0pi -e 's/\n{3,}/\n\n/g; s/\s+\z/\n/' "$msg_file"

if [[ "$before" != "$(cat "$msg_file")" ]]; then
  echo "commit-msg: removed agent-attribution trailer (CLAUDE.md: Commits/PRs)." >&2
fi
