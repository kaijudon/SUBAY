# SUBAY environment template.
# In production these values come from a root-owned 0600 file loaded by systemd,
# NOT from this repo. Copy to .env for local development only.

# Postgres in production; omit locally to fall back to sqlite for tests.
DATABASE_URL=postgres://subay:subay@127.0.0.1:5432/subay

DJANGO_SECRET_KEY=change-me-use-a-systemd-supplied-secret-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
